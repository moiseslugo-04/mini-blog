generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String?  @unique
  email     String   @unique
  password  String
  avatarUrl String?
  bio       String?
  role      Role     @default(READER)
  createdAt DateTime @default(now())
  posts     Post[]
    @@map("users")

}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  description String
  content   String
  imageUrl  String
  tags  Tag[]
  published Boolean  @default(true)
  readTime  Int
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  
  
  @@map("posts")
  @@index([authorId])
}
model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug     String @unique
  isPublic Boolean @default(false)
  posts Post[]
}
enum Role {
  ADMIN
  EDITOR
  READER
}

model Project{
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String
  projectUrl  String
  technologies  Technology[]
  published Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  @@map("projects")  
}

model Technology{
  id       String @id @default(cuid())
  name     String @unique
  slug     String @unique
  icon     String
  
  projects Project[]
    @@map("technologies")
}

